{
  "rewrites": [
    {
      "source": "/lesson/:course/:lesson",
      "destination": "/pages/lesson.html?course=:course&lesson=:lesson"
    },
    {
      "source": "/lesson/:course",
      "destination": "/:course.html"
    },
    {
      "source": "/bookmarks/:username",
      "destination": "/bookmarks.html"
    },
    {
      "source": "/highlights/:username",
      "destination": "/highlights.html"
    },
    {
      "source": "/notes/:username",
      "destination": "/notes.html"
    }
  ]
}
